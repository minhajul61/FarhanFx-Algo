# HTTPS certificates are issued and renewed by Caddy automatically (Let's Encrypt)
farhanfxalgo.in {
	encode gzip
	reverse_proxy 127.0.0.1:8000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	request_body {
		max_size 8MB
	}
}

www.farhanfxalgo.in {
	redir https://farhanfxalgo.in{uri} permanent
}
